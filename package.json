{
  "name": "rm-restaurant-saas",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "db:generate": "npm run db:generate --workspace packages/db",
    "db:migrate": "npm run db:migrate --workspace packages/db",
    "db:deploy": "npm run db:deploy --workspace packages/db",
    "seed:master": "npm run seed:master --workspace apps/api"
  }
}
