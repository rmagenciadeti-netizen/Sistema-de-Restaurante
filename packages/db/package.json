generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      TenantStatus @default(TRIAL)
  plan        PlanType @default(BASIC)
  country     String   @default("BR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units        Unit[]
  users        User[]
  employees    Employee[]
  products     Product[]
  categories   ProductCategory[]
  sectors      ProductionSector[]
  orders       Order[]
  invoices     Invoice[]
  integrations Integration[]
}

model Unit {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  address     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  employees   Employee[]
  products    Product[]
  orders      Order[]
  sectors     ProductionSector[]
}

model User {
  id          String   @id @default(uuid())
  tenantId    String
  unitId      String?
  name        String
  email       String   @unique
  passwordHash String?
  role        UserRole @default(ADMIN)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  unit        Unit?    @relation(fields: [unitId], references: [id])
}

model Employee {
  id            String   @id @default(uuid())
  tenantId      String
  unitId        String?
  fullName      String
  cpf           String?
  phone         String?
  email         String?
  position      String?
  status        String   @default("ACTIVE")
  salary        Decimal?
  admissionDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  unit          Unit?  @relation(fields: [unitId], references: [id])
}

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  createdAt   DateTime @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  unitId           String?
  categoryId       String?
  name             String
  code             String?
  barcode          String?
  description      String?
  price            Decimal
  cost             Decimal?
  stockMin         Decimal?
  stockCurrent     Decimal? @default(0)
  prepTimeMinutes  Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant @relation(fields: [tenantId], references: [id])
  unit             Unit?  @relation(fields: [unitId], references: [id])
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
}

model ProductionSector {
  id           String   @id @default(uuid())
  tenantId     String
  unitId       String?
  name         String
  code         String?
  color        String?
  autoPrint    Boolean @default(false)
  status       String  @default("ACTIVE")
  createdAt    DateTime @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  unit         Unit?  @relation(fields: [unitId], references: [id])
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String
  unitId      String?
  code        String
  channel     OrderChannel @default(POS)
  status      OrderStatus  @default(OPEN)
  total       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  unit        Unit?    @relation(fields: [unitId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int      @default(1)
  unitPrice   Decimal
  total       Decimal
  createdAt   DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Invoice {
  id          String   @id @default(uuid())
  tenantId    String
  number      String
  type        String
  status      String   @default("DRAFT")
  total       Decimal
  createdAt   DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
}

model Integration {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  type        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  BLOCKED
}

enum PlanType {
  BASIC
  PRO
  PREMIUM
  ENTERPRISE
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  DELIVERY
  FINANCE
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OrderChannel {
  POS
  DELIVERY
  TAKEAWAY
  WHATSAPP
  TABLE
}

enum OrderStatus {
  OPEN
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
