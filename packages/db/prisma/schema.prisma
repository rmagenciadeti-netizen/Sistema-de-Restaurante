model SaaSPlan {
  id            String          @id @default(uuid())
  key           String          @unique
  name          String
  description   String?
  active        Boolean         @default(true)
  trialDays     Int             @default(0)
  maxUnits      Int?
  maxUsers      Int?
  activationFee Decimal         @default(0) @db.Decimal(12, 2)
  setupFee      Decimal         @default(0) @db.Decimal(12, 2)
  status        CatalogStatus   @default(ACTIVE)
  headline      String?
  benefits      String[]        @default([])
  highlight     String?
  displayOrder  Int             @default(0)
  originalPrice Decimal?        @db.Decimal(12, 2)
  promoPrice    Decimal?        @db.Decimal(12, 2)
  conditions    String?
