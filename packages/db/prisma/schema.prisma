generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  status                TenantStatus           @default(TRIAL)
  plan                  PlanType               @default(BASIC)
  country               String                 @default("BR")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  units                 Unit[]
  users                 User[]
  employees             Employee[]
  categories            ProductCategory[]
  sectors               ProductionSector[]
  printers              Printer[]
  products              Product[]
  productUnitPrices     ProductUnitPrice[]
  productStockMovements ProductStockMovement[]
  orders                Order[]
  auditLogs             AuditLog[]
  ingredients           Ingredient[]
  stockMovements        StockMovement[]
  recipes               Recipe[]
  cashSessions          CashSession[]
  payments              Payment[]
  tefConfigs            TefProviderConfig[]
  tefTransactions       TefTransaction[]
  aiUsageEvents         AiUsageEvent[]
  aiConversations       AiConversation[]
  deliveryJobs          DeliveryJob[]
  whatsappMessages      WhatsappMessage[]
  financialEntries      FinancialEntry[]
  customers             Customer[]
  loyaltyEntries        LoyaltyEntry[]
  inventoryCounts       InventoryCount[]
  tableRequests         TableRequest[]
  notifications         Notification[]
  commissionRules       CommissionRule[]
  commissionClosings    CommissionClosing[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  tables                RestaurantTable[]
  printJobs             PrintJob[]
  printAgents           PrintAgent[]
  coupons               Coupon[]
  reservations          Reservation[]
  deliveryZones         DeliveryZone[]
  modifierGroups        ModifierGroup[]
  shifts                Shift[]
  paymentCharges        PaymentCharge[]
  fiscalDocuments       FiscalDocument[]
  integrations          Integration[]
  externalOrders        ExternalOrder[]
  license               TenantLicense?
  modules               TenantModule[]
  provisioning          TenantProvisioning?
  settings              TenantSettings?
  couriers              Courier[]
  carriers              Carrier[]
  paymentMethods        PaymentMethodConfig[]
  financialCategories   FinancialCategory[]
  promotions            Promotion[]
  categorySchedules     CategorySchedule[]
  coverEvents           CoverEvent[]
  passwordReleases      PasswordRelease[]
  taxRules              TaxRule[]
  operationNatures      OperationNature[]
  cstCorrelations       CstCorrelation[]
  receivedInvoices      ReceivedInvoice[]
  fiscalContingencies   FiscalContingency[]
  posDevices            PosDevice[]
  storeImages           StoreImage[]
  fiscalNumbering       FiscalNumbering[]
  fiscalSettings        FiscalSettings?
  fiscalUnitConfigs     FiscalUnitConfig[]
  fiscalEvents          FiscalEvent[]
  whatsappSession       WhatsappSession?
  whatsappConversations WhatsappConversation[]
  whatsappAutoMessages  WhatsappAutoMessage[]
  whatsappKnowledge     WhatsappKnowledge[]
  whatsappUnanswered    WhatsappUnanswered[]
  saasInvoices          SaaSInvoice[]
  couponRedemptions     SaaSCouponRedemption[]
  supportTickets        SupportTicket[]
  migrationSessions     MigrationSession[]
  migrationFiles        MigrationFile[]
  migrationRecords      MigrationRecord[]
  migrationEvents       MigrationEvent[]
  migrationBackups      MigrationBackup[]
  costCenters           CostCenter[]
  productPricings       ProductPricing[]
  priceHistory          PriceHistory[]
  bankAccounts          BankAccount[]

  @@index([status, createdAt])
}

model Unit {
  id                    String                 @id @default(uuid())
  tenantId              String
  name                  String
  code                  String?
  address               String?
  status                String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]
  employees             Employee[]
  sectors               ProductionSector[]
  printers              Printer[]
  products              Product[]
  productStockMovements ProductStockMovement[]
  orders                Order[]
  ingredients           Ingredient[]
  stockMovements        StockMovement[]
  cashSessions          CashSession[]
  payments              Payment[]
  deliveryJobs          DeliveryJob[]
  financialEntries      FinancialEntry[]
  serviceFeePercent     Decimal                @default(0) @db.Decimal(5, 2)
  tables                RestaurantTable[]
  printJobs             PrintJob[]
  printAgents           PrintAgent[]
  purchaseOrders        PurchaseOrder[]
  reservations          Reservation[]
  deliveryZones         DeliveryZone[]
  waiterSharePercent    Decimal                @default(100) @db.Decimal(5, 2)
  shifts                Shift[]
  paymentCharges        PaymentCharge[]
  fiscalConfig          FiscalUnitConfig?
  fiscalDocuments       FiscalDocument[]
  receivedInvoices      ReceivedInvoice[]
  posDevices            PosDevice[]
  migrationSessions     MigrationSession[]
  productUnitPrices     ProductUnitPrice[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model User {
  id                       String     @id @default(uuid())
  tenantId                 String?
  unitId                   String?
  employeeId               String?    @unique
  username                 String?    @unique
  name                     String
  email                    String     @unique
  passwordHash             String
  mfaEnabled               Boolean    @default(false)
  mfaSecretEncrypted       String?
  mfaRecoveryCodeHashes    String[]   @default([])
  mfaLastUsedStep          BigInt?
  authVersion              Int        @default(0)
  passwordResetTokenHash   String?    @unique
  passwordResetExpiresAt   DateTime?
  passwordResetRequestedAt DateTime?
  mustChangePassword       Boolean    @default(false)
  role                     UserRole   @default(ADMIN)
  status                   UserStatus @default(ACTIVE)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  tenant                   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                     Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employee                 Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs                AuditLog[]
  createdOrders            Order[]    @relation("OrderCreator")
  commissionPercent        Decimal    @default(0) @db.Decimal(5, 2)
  appearance               Json?

  @@index([tenantId, unitId, status])
}

model Employee {
  id            String    @id @default(uuid())
  tenantId      String
  unitId        String?
  fullName      String
  cpf           String?
  phone         String?
  email         String?
  position      String?
  status        String    @default("ACTIVE")
  admissionDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  shifts        Shift[]
  user          User?

  @@index([tenantId, unitId, status])
  @@index([tenantId, fullName])
}

model ProductCategory {
  id        String             @id @default(uuid())
  tenantId  String
  parentId  String?
  parent    ProductCategory?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[]  @relation("CategoryTree")
  name      String
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  schedules CategorySchedule[]

  @@unique([tenantId, name])
}

model ProductionSector {
  id              String           @id @default(uuid())
  tenantId        String
  unitId          String?
  name            String
  code            String?
  color           String?
  description     String?
  sortOrder       Int              @default(0)
  avgPrepMinutes  Int?
  autoPrint       Boolean          @default(false)
  showOnKds       Boolean          @default(true)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  printers        Printer[]
  printJobs       PrintJob[]
  products        Product[]
  orderItems      OrderItem[]
  modifierOptions ModifierOption[]

  @@unique([tenantId, unitId, name])
  @@index([tenantId, unitId, active])
}

model Printer {
  id             String            @id @default(uuid())
  tenantId       String
  unitId         String?
  sectorId       String?
  // Windows printers can only be reached by the agent installed on the computer that has them.
  agentId        String?
  name           String
  connectionType String
  address        String?
  port           Int?
  paperWidthMm   Int               @default(80)
  kind           PrinterKind       @default(KITCHEN)
  manufacturer   String?
  model          String?
  isPrimary      Boolean           @default(false)
  autoCut        Boolean           @default(true)
  cashDrawer     Boolean           @default(false)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sector         ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  agent          PrintAgent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  printJobs      PrintJob[]

  @@index([tenantId, unitId, active])
}

model Product {
  id                      String                 @id @default(uuid())
  tenantId                String
  unitId                  String?
  categoryId              String?
  supplierId              String?
  sectorId                String?
  name                    String
  code                    String?
  description             String?
  price                   Decimal                @db.Decimal(12, 2)
  cost                    Decimal?               @db.Decimal(12, 2)
  stockMin                Decimal?               @db.Decimal(12, 3)
  stockControlled         Boolean                @default(false)
  stockQuantity           Decimal                @default(0) @db.Decimal(12, 3)
  packagingEnabled        Boolean                @default(false)
  packagingPrice          Decimal                @default(0) @db.Decimal(12, 2)
  prepTimeMinutes         Int?
  active                  Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                    Unit?                  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category                ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier                Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sector                  ProductionSector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  orderItems              OrderItem[]
  recipe                  Recipe?
  isCombo                 Boolean                @default(false)
  modifierGroups          ProductModifierGroup[]
  comboComponents         ComboComponent[]       @relation("ComboParent")
  usedInCombos            ComboComponent[]       @relation("ComboChild")
  barcode                 String?
  favorite                Boolean                @default(false)
  // Weighed products: `price` is per kg and order lines carry weightKg. `scaleCode` is the PLU sent to / read from the scale.
  soldByWeight            Boolean                @default(false)
  sendToScale             Boolean                @default(false)
  scaleCode               Int?
  scaleDepartment         Int?
  shelfLifeDays           Int?
  scaleNotes              String?
  ncm                     String?
  cest                    String?
  taxRuleId               String?
  taxRule                 TaxRule?               @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  gtin                    String?
  measureUnit             String                 @default("UN")
  // localOnly: sold only at the venue (hidden from the virtual store and the WhatsApp bot). isComponent: ingredient/part of other products, never sold on its own online.
  localOnly               Boolean                @default(false)
  isComponent             Boolean                @default(false)
  allowNotes              Boolean                @default(true)
  allowFreePrice          Boolean                @default(false)
  alwaysShowDescription   Boolean                @default(false)
  allowFractionalQuantity Boolean                @default(false)
  pickupTicket            Boolean                @default(false)
  // Fiscal item kind (SPED Bloco K table): MERCHANDISE, RAW_MATERIAL, PACKAGING, IN_PROCESS, FINISHED, BY_PRODUCT, CONSUMABLE, SERVICE, OTHER.
  productType             String                 @default("FINISHED")
  promotionItems          PromotionProduct[]
  image                   ProductImage?
  stockMovements          ProductStockMovement[]
  pricing                 ProductPricing?
  priceHistory            PriceHistory[]
  unitPrices              ProductUnitPrice[]

  @@unique([tenantId, code])
  @@unique([tenantId, scaleCode])
  @@index([tenantId, unitId, active])
  @@index([tenantId, name])
}

model Order {
  id                String            @id @default(uuid())
  tenantId          String
  unitId            String?
  code              String
  channel           OrderChannel      @default(POS)
  status            OrderStatus       @default(OPEN)
  customerName      String?
  tableLabel        String?
  customerId        String?
  tableId           String?
  couponId          String?
  deliveryZoneId    String?
  number            Int?
  scheduledFor      DateTime?
  releaseAt         DateTime?
  releasedAt        DateTime?
  couvertFee        Decimal           @default(0) @db.Decimal(12, 2)
  subtotal          Decimal           @db.Decimal(12, 2)
  serviceFee        Decimal           @default(0) @db.Decimal(12, 2)
  deliveryFee       Decimal           @default(0) @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  financialEntry    FinancialEntry?
  deliveryJob       DeliveryJob?
  whatsappMessages  WhatsappMessage[]
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table             RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryZone      DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  printJobs         PrintJob[]
  createdByUserId   String?
  createdBy         User?             @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paymentCharges    PaymentCharge[]
  fiscalDocuments   FiscalDocument[]
  externalOrder     ExternalOrder?
  // PDV fiscal decision frozen at checkout: FISCAL or NON_FISCAL (null = legacy/not decided).
  fiscalMode        String?
  fiscalDecidedById String?
  fiscalDecidedAt   DateTime?
  // Why the order is held away from production/printing (e.g. QR_CONFIRMATION waits for the staff to accept it).
  holdReason        String?
  // Kitchen priority flag set from the KDS.
  priority          Boolean           @default(false)
  // Idempotency key sent by the offline PDV queue: the same key never creates a second order.
  clientRequestId   String?

  @@unique([tenantId, code])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, unitId, status, createdAt])
}

model OrderItem {
  id             String              @id @default(uuid())
  orderId        String
  productId      String
  sectorId       String?
  quantity       Decimal             @db.Decimal(12, 3)
  withPackaging  Boolean             @default(false)
  packagingPrice Decimal             @default(0) @db.Decimal(12, 2)
  weightKg       Decimal?            @db.Decimal(10, 3)
  unitPrice      Decimal             @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
  // Registered cost of the product when the item was sold: old sales are never re-costed with today's cost.
  unitCost       Decimal?            @db.Decimal(12, 4)
  notes          String?
  status         OrderItemStatus     @default(PENDING)
  // Custom KDS stage chosen by the restaurant (key of settings.kdsStages). It refines `status`, which stays the one the order rules use.
  kdsStage       String?
  // Production timeline: when preparation started, when it was ready and when it was handed to the customer/waiter.
  startedAt      DateTime?
  readyAt        DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector         ProductionSector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  parentItemId   String?
  parentItem     OrderItem?          @relation("ComboChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  children       OrderItem[]         @relation("ComboChildren")
  modifiers      OrderItemModifier[]

  @@index([orderId, status])
  @@index([sectorId, status, createdAt])
}

model Ingredient {
  id              String               @id @default(uuid())
  tenantId        String
  unitId          String?
  name            String
  unitOfMeasure   String
  currentStock    Decimal              @default(0) @db.Decimal(14, 3)
  minimumStock    Decimal?             @db.Decimal(14, 3)
  maximumStock    Decimal?             @db.Decimal(14, 3)
  category        String?
  // Earliest expiry date among the units in stock, informed on receiving/counting; drives the "próximos do vencimento" alert.
  expiresAt       DateTime?
  averageCost     Decimal              @default(0) @db.Decimal(12, 4)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit            Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  recipeLines     RecipeIngredient[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  countLines      InventoryCountLine[]
  modifierOptions ModifierOption[]

  @@index([tenantId, unitId, active])
  @@index([tenantId, name])
}

model Supplier {
  id                String           @id @default(uuid())
  tenantId          String
  name              String
  document          String?
  phone             String?
  email             String?
  tradeName         String?
  stateRegistration String?
  address           String?
  zip               String?
  city              String?
  state             String?
  contactName       String?
  notes             String?
  updatedAt         DateTime         @default(now()) @updatedAt
  products          Product[]
  financialEntries  FinancialEntry[]
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders    PurchaseOrder[]

  @@unique([tenantId, name])
}

model PurchaseOrder {
  id                String         @id @default(uuid())
  tenantId          String
  unitId            String?
  supplierId        String
  code              String
  status            PurchaseStatus @default(DRAFT)
  total             Decimal        @db.Decimal(14, 2)
  dueAt             DateTime?
  notes             String?
  receivedAt        DateTime?
  // Receiving conference: what actually arrived (may differ from the order) and the supplier invoice it was checked against.
  receivedTotal     Decimal?       @db.Decimal(14, 2)
  receivedInvoiceId String?
  receiptNote       String?
  receivedById      String?
  createdAt         DateTime       @default(now())
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items             PurchaseItem[]

  @@unique([tenantId, code])
  @@index([tenantId, unitId, status, createdAt])
}

model PurchaseItem {
  id               String        @id @default(uuid())
  purchaseId       String
  ingredientId     String
  quantity         Decimal       @db.Decimal(14, 3)
  unitCost         Decimal       @db.Decimal(12, 4)
  receivedQuantity Decimal?      @db.Decimal(14, 3)
  receivedUnitCost Decimal?      @db.Decimal(12, 4)
  purchase         PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

// Guided inventory session: a snapshot of what the system expected, the physical counts and the adjustments applied when it is closed.
model InventoryCount {
  id          String               @id @default(uuid())
  tenantId    String
  unitId      String?
  title       String
  scope       InventoryScope
  category    String?
  status      InventoryCountStatus @default(OPEN)
  note        String?
  startedById String
  closedById  String?
  createdAt   DateTime             @default(now())
  closedAt    DateTime?
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines       InventoryCountLine[]

  @@index([tenantId, unitId, status, createdAt])
}

model InventoryCountLine {
  id            String         @id @default(uuid())
  countId       String
  ingredientId  String
  name          String
  unitOfMeasure String
  expected      Decimal        @db.Decimal(14, 3)
  counted       Decimal?       @db.Decimal(14, 3)
  adjustment    Decimal?       @db.Decimal(14, 3)
  unitCost      Decimal        @db.Decimal(12, 4)
  note          String?
  count         InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredient    Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([countId, ingredientId])
  @@index([ingredientId])
}

enum InventoryScope {
  FULL
  PARTIAL
  CATEGORY
}

enum InventoryCountStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum WasteReason {
  EXPIRED
  DAMAGED
  PRODUCTION
  OTHER
}

model Recipe {
  id          String             @id @default(uuid())
  tenantId    String
  productId   String             @unique
  yield       Decimal            @default(1) @db.Decimal(12, 3)
  notes       String?
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId])
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  unitId       String?
  ingredientId String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3)
  unitCost     Decimal?          @db.Decimal(12, 4)
  reference    String?
  note         String?
  reason       WasteReason?
  actorUserId  String?
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([tenantId, unitId, createdAt])
  @@index([ingredientId, createdAt])
}

model ProductStockMovement {
  id          String                   @id @default(uuid())
  tenantId    String
  unitId      String?
  productId   String
  type        ProductStockMovementType
  quantity    Decimal                  @db.Decimal(12, 3)
  reference   String?
  note        String?
  actorUserId String?
  createdAt   DateTime                 @default(now())
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, unitId, createdAt])
  @@index([productId, createdAt])
  @@index([tenantId, reference, type])
}

model CashSession {
  id             String            @id @default(uuid())
  tenantId       String
  unitId         String?
  openedByUserId String
  closedByUserId String?
  openingAmount  Decimal           @db.Decimal(12, 2)
  closingAmount  Decimal?          @db.Decimal(12, 2)
  expectedAmount Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  payments       Payment[]

  @@index([tenantId, unitId, status, openedAt])
}

model Payment {
  id                String          @id @default(uuid())
  tenantId          String
  unitId            String?
  orderId           String?
  cashSessionId     String?
  method            PaymentMethod
  amount            Decimal         @db.Decimal(12, 2)
  reference         String?
  status            PaymentStatus   @default(CONFIRMED)
  paidAt            DateTime        @default(now())
  // Real data returned by an integrated payment provider (TEF/PIX). Null when the payment was typed manually: nothing is invented.
  integrated        Boolean         @default(false)
  nsu               String?
  authorizationCode String?
  cardBrand         String?
  acquirerCnpj      String?
  installments      Int?
  pixEndToEnd       String?
  terminalId        String?
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashSession       CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  tefTransaction    TefTransaction?

  @@index([tenantId, unitId, paidAt])
  @@index([orderId, status])
}

model DeliveryJob {
  id           String         @id @default(uuid())
  tenantId     String
  unitId       String?
  orderId      String         @unique
  courierId    String?
  courierName  String?
  courierPhone String?
  address      String?
  status       DeliveryStatus @default(PENDING)
  provider     String?
  externalRef  String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  // Amount owed to the courier for this delivery, frozen when it is delivered (fixed value + commission on the delivery fee).
  payout       Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier?       @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@index([tenantId, unitId, status, createdAt])
}

model WhatsappMessage {
  id          String        @id @default(uuid())
  tenantId    String
  orderId     String?
  toPhone     String
  template    String
  payload     Json?
  status      MessageStatus @default(QUEUED)
  providerRef String?
  error       String?
  createdAt   DateTime      @default(now())
  sentAt      DateTime?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model FinancialEntry {
  id                String               @id @default(uuid())
  tenantId          String
  unitId            String?
  orderId           String?              @unique
  customerId        String?
  debtorName        String?
  description       String
  type              FinancialEntryType
  category          String?
  amount            Decimal              @db.Decimal(12, 2)
  paidAmount        Decimal              @default(0) @db.Decimal(12, 2)
  dueAt             DateTime?
  settledAt         DateTime?
  status            FinancialEntryStatus @default(OPEN)
  reference         String?
  supplierId        String?
  documentNumber    String?
  installmentNumber Int?
  installmentCount  Int?
  issuedAt          DateTime?
  interestAmount    Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal              @default(0) @db.Decimal(12, 2)
  costCenterId      String?
  bankAccountId     String?
  paymentMethod     String?
  notes             String?
  // Set when the entry was matched to a bank statement line (bank reconciliation).
  reconciledAt      DateTime?
  updatedAt         DateTime             @default(now()) @updatedAt
  supplier          Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  bankAccount       BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order             Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, unitId, status, dueAt])
  @@index([tenantId, type, settledAt])
  @@index([tenantId, type, documentNumber])
  @@index([tenantId, customerId, status])
}

model Customer {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  phone            String
  email            String?
  document         String?
  address          String?
  zip              String?
  city             String?
  state            String?
  whatsapp         String?
  notes            String?
  marketingConsent Boolean          @default(false)
  loyaltyPoints    Int              @default(0)
  birthDate        DateTime?        @db.Date
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  financialEntries FinancialEntry[]
  loyaltyEntries   LoyaltyEntry[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

// Points ledger: Customer.loyaltyPoints is always the sum of `points` (signed) and every change is recorded here with who/why.
model LoyaltyEntry {
  id           String           @id @default(uuid())
  tenantId     String
  customerId   String
  orderId      String?
  type         LoyaltyEntryType
  points       Int
  balanceAfter Int
  note         String?
  actorUserId  String?
  couponCode   String?
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, orderId])
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
}

model RestaurantTable {
  id           String         @id @default(uuid())
  tenantId     String
  unitId       String
  label        String
  seats        Int            @default(4)
  qrToken      String         @unique
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]
  requests     TableRequest[]

  @@unique([tenantId, unitId, label])
}

// Customer calls from the QR menu: "chamar garçom" and "pedir a conta". One open request per type and table, answered by the staff.
model TableRequest {
  id          String             @id @default(uuid())
  tenantId    String
  unitId      String
  tableId     String
  type        TableRequestType
  status      TableRequestStatus @default(OPEN)
  note        String?
  createdAt   DateTime           @default(now())
  handledAt   DateTime?
  handledById String?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table       RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, unitId, status, createdAt])
  @@index([tableId, type, status])
}

enum TableRequestType {
  WAITER
  BILL
}

// Price of a product in one unit (store); without a row the product's own price applies. Charged by order-engine's priceOrderLines.
model ProductUnitPrice {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  unitId    String
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, unitId])
  @@index([tenantId, unitId])
}

// Frozen commission statement for a period. Later cancellations/refunds do not rewrite it: the difference against the live calculation is shown as an adjustment.
model CommissionClosing {
  id         String   @id @default(uuid())
  tenantId   String
  periodFrom DateTime
  periodTo   DateTime
  lines      Json
  total      Decimal  @db.Decimal(12, 2)
  closedById String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

enum CommissionKind {
  SALE_PERCENT
  PRODUCT_PERCENT
  GOAL_BONUS
}

// Staff commission rules (section 15). Scope is optional per person (userId) and/or role; PRODUCT_PERCENT also needs productId and GOAL_BONUS a goal.
model CommissionRule {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  kind        CommissionKind
  userId      String?
  role        String?
  productId   String?
  percent     Decimal?       @db.Decimal(5, 2)
  goalAmount  Decimal?       @db.Decimal(12, 2)
  bonusAmount Decimal?       @db.Decimal(12, 2)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// In-app notifications produced by the automations center (alerts, daily summary, weekly report, goals). `dedupeKey` makes every
// situation/period notify once: the unique (tenant, dedupeKey) pair is what prevents notification floods.
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  ruleKey   String
  dedupeKey String
  severity  String    @default("INFO")
  title     String
  body      String
  href      String?
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, readAt, createdAt])
}

enum TableRequestStatus {
  OPEN
  DONE
}

model PrintAgent {
  id                 String    @id @default(uuid())
  tenantId           String
  unitId             String?
  name               String
  tokenHash          String    @unique
  active             Boolean   @default(true)
  lastSeenAt         DateTime?
  // Printers installed on the agent's computer ([{ name, isDefault, driver, port, status }]), reported by the agent itself.
  printers           Json      @default("[]")
  printersReportedAt DateTime?
  createdAt          DateTime  @default(now())
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  printerLinks       Printer[]

  @@index([tenantId, active])
}

model PrintJob {
  id               String            @id @default(uuid())
  tenantId         String
  unitId           String?
  printerId        String?
  sectorId         String?
  orderId          String?
  kind             PrintJobKind      @default(PRODUCTION)
  content          String
  status           PrintJobStatus    @default(PENDING)
  attempts         Int               @default(0)
  error            String?
  claimedAt        DateTime?
  claimedByAgentId String?
  claimId          String?
  printedAt        DateTime?
  // Receipts (TEF, sale, fiscal) carry a key so that the same original is never queued twice; a reprint is a separate, audited job without key. A partial unique index in the migration enforces it.
  dedupKey         String?
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  printer          Printer?          @relation(fields: [printerId], references: [id], onDelete: SetNull)
  sector           ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, unitId, status, createdAt])
  @@index([orderId])
}

model Coupon {
  id         String       @id @default(uuid())
  tenantId   String
  code       String
  type       DiscountType
  value      Decimal      @db.Decimal(12, 2)
  minOrder   Decimal?     @db.Decimal(12, 2)
  maxUses    Int?
  usedCount  Int          @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([tenantId, code])
}

model DeliveryZone {
  id               String   @id @default(uuid())
  tenantId         String
  unitId           String?
  name             String
  fee              Decimal  @db.Decimal(12, 2)
  minOrder         Decimal? @db.Decimal(12, 2)
  estimatedMinutes Int?
  // Neighborhoods served by this zone (customers pick theirs on the store; the zone sets fee, minimum and time).
  neighborhoods    String[] @default([])
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  orders           Order[]

  @@unique([tenantId, unitId, name])
}

model Reservation {
  id           String            @id @default(uuid())
  tenantId     String
  unitId       String
  tableId      String?
  customerName String
  phone        String?
  partySize    Int
  reservedAt   DateTime
  status       ReservationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  table        RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

