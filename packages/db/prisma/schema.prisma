generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(TRIAL)
  plan        PlanType     @default(BASIC)
  country     String       @default("BR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  units       Unit[]
  users       User[]
  employees   Employee[]
  categories  ProductCategory[]
  sectors     ProductionSector[]
  printers    Printer[]
  products    Product[]
  orders      Order[]
  auditLogs   AuditLog[]
  ingredients Ingredient[]
  stockMovements StockMovement[]
  recipes     Recipe[]
  cashSessions CashSession[]
  payments    Payment[]
  deliveryJobs DeliveryJob[]
  whatsappMessages WhatsappMessage[]
  financialEntries FinancialEntry[]
  @@index([status, createdAt])
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  employees Employee[]
  sectors   ProductionSector[]
  printers  Printer[]
  products  Product[]
  orders    Order[]
  ingredients Ingredient[]
  stockMovements StockMovement[]
  cashSessions CashSession[]
  payments Payment[]
  deliveryJobs DeliveryJob[]
  financialEntries FinancialEntry[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  unitId       String?
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  @@index([tenantId, unitId, status])
}

model Employee {
  id            String   @id @default(uuid())
  tenantId      String
  unitId        String?
  fullName      String
  cpf           String?
  phone         String?
  email         String?
  position      String?
  status        String   @default("ACTIVE")
  admissionDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, status])
  @@index([tenantId, fullName])
}

model ProductCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  @@unique([tenantId, name])
}

model ProductionSector {
  id        String    @id @default(uuid())
  tenantId  String
  unitId    String?
  name      String
  code      String?
  color     String?
  autoPrint Boolean   @default(false)
  showOnKds Boolean   @default(true)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  printers  Printer[]
  products  Product[]
  orderItems OrderItem[]
  @@unique([tenantId, unitId, name])
  @@index([tenantId, unitId, active])
}

model Printer {
  id             String   @id @default(uuid())
  tenantId       String
  unitId         String?
  sectorId       String?
  name           String
  connectionType String
  address        String?
  port           Int?
  paperWidthMm   Int      @default(80)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sector         ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, active])
}

model Product {
  id               String           @id @default(uuid())
  tenantId         String
  unitId           String?
  categoryId       String?
  sectorId         String?
  name             String
  code             String?
  description      String?
  price            Decimal          @db.Decimal(12, 2)
  cost             Decimal?         @db.Decimal(12, 2)
  stockMin         Decimal?         @db.Decimal(12, 3)
  prepTimeMinutes  Int?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sector           ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  recipe           Recipe?
  @@unique([tenantId, code])
  @@index([tenantId, unitId, active])
  @@index([tenantId, name])
}

model Order {
  id           String       @id @default(uuid())
  tenantId     String
  unitId       String?
  code         String
  channel      OrderChannel @default(POS)
  status       OrderStatus  @default(OPEN)
  customerName String?
  tableLabel   String?
  subtotal     Decimal      @db.Decimal(12, 2)
  serviceFee   Decimal      @default(0) @db.Decimal(12, 2)
  deliveryFee  Decimal      @default(0) @db.Decimal(12, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  deliveryJob  DeliveryJob?
  whatsappMessages WhatsappMessage[]
  @@unique([tenantId, code])
  @@index([tenantId, unitId, status, createdAt])
}

model OrderItem {
  id        String           @id @default(uuid())
  orderId   String
  productId String
  sectorId  String?
  quantity  Int
  unitPrice Decimal          @db.Decimal(12, 2)
  total     Decimal          @db.Decimal(12, 2)
  notes     String?
  status    OrderItemStatus  @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector    ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  @@index([orderId, status])
  @@index([sectorId, status, createdAt])
}

model Ingredient {
  id          String   @id @default(uuid())
  tenantId    String
  unitId      String?
  name        String
  unitOfMeasure String
  currentStock Decimal  @default(0) @db.Decimal(14, 3)
  minimumStock Decimal? @db.Decimal(14, 3)
  averageCost Decimal   @default(0) @db.Decimal(12, 4)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  recipeLines RecipeIngredient[]
  movements   StockMovement[]
  @@index([tenantId, unitId, active])
  @@index([tenantId, name])
}

model Recipe {
  id        String   @id @default(uuid())
  tenantId  String
  productId String   @unique
  yield     Decimal  @default(1) @db.Decimal(12, 3)
  notes     String?
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  @@index([tenantId])
}

model RecipeIngredient {
  id           String    @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal   @db.Decimal(14, 3)
  recipe       Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@unique([recipeId, ingredientId])
}

model StockMovement {
  id           String           @id @default(uuid())
  tenantId     String
  unitId       String?
  ingredientId String
  type         StockMovementType
  quantity     Decimal          @db.Decimal(14, 3)
  unitCost     Decimal?         @db.Decimal(12, 4)
  reference    String?
  note         String?
  actorUserId  String?
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  ingredient   Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@index([tenantId, unitId, createdAt])
  @@index([ingredientId, createdAt])
}

model CashSession {
  id              String          @id @default(uuid())
  tenantId        String
  unitId          String?
  openedByUserId  String
  closedByUserId  String?
  openingAmount   Decimal         @db.Decimal(12, 2)
  closingAmount   Decimal?        @db.Decimal(12, 2)
  expectedAmount  Decimal?        @db.Decimal(12, 2)
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit            Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  payments        Payment[]
  @@index([tenantId, unitId, status, openedAt])
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  unitId        String?
  orderId       String?
  cashSessionId String?
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  status        PaymentStatus @default(CONFIRMED)
  paidAt        DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, paidAt])
  @@index([orderId, status])
}

model DeliveryJob {
  id             String         @id @default(uuid())
  tenantId       String
  unitId         String?
  orderId        String         @unique
  courierName    String?
  courierPhone   String?
  address        String?
  status         DeliveryStatus @default(PENDING)
  provider       String?
  externalRef    String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([tenantId, unitId, status, createdAt])
}

model WhatsappMessage {
  id          String          @id @default(uuid())
  tenantId    String
  orderId     String?
  toPhone     String
  template    String
  payload     Json?
  status      MessageStatus   @default(QUEUED)
  providerRef String?
  error       String?
  createdAt   DateTime        @default(now())
  sentAt      DateTime?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([tenantId, status, createdAt])
}

model FinancialEntry {
  id          String             @id @default(uuid())
  tenantId    String
  unitId      String?
  description String
  type        FinancialEntryType
  category    String?
  amount      Decimal            @db.Decimal(12, 2)
  dueAt       DateTime?
  settledAt   DateTime?
  status      FinancialEntryStatus @default(OPEN)
  reference   String?
  createdAt   DateTime           @default(now())
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, status, dueAt])
  @@index([tenantId, type, settledAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

enum TenantStatus { ACTIVE TRIAL SUSPENDED BLOCKED }
enum PlanType { BASIC PRO PREMIUM ENTERPRISE }
enum UserRole { MASTER_ADMIN ADMIN MANAGER CASHIER WAITER KITCHEN DELIVERY FINANCE SUPPORT }
enum UserStatus { ACTIVE INACTIVE BLOCKED }
enum OrderChannel { POS DELIVERY TAKEAWAY WHATSAPP TABLE }
enum OrderStatus { OPEN PREPARING READY COMPLETED CANCELLED }
enum OrderItemStatus { PENDING PREPARING READY CANCELLED }
enum StockMovementType { PURCHASE ADJUSTMENT WASTE ORDER_CONSUMPTION TRANSFER_IN TRANSFER_OUT }
enum CashSessionStatus { OPEN CLOSED }
enum PaymentMethod { CASH PIX CREDIT_CARD DEBIT_CARD VOUCHER OTHER }
enum PaymentStatus { CONFIRMED REFUNDED CANCELLED }
enum DeliveryStatus { PENDING ASSIGNED PICKED_UP DELIVERED CANCELLED }
enum MessageStatus { QUEUED SENT FAILED }
enum FinancialEntryType { INCOME EXPENSE }
enum FinancialEntryStatus { OPEN PAID CANCELLED }
