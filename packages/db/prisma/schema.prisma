  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

// Per-tenant configuration. `settings` holds validated sections (company, hours, store, pdv, scale, scheduling, ...), see apps/api/src/lib/settings.ts.
model TenantSettings {
  tenantId          String    @id
  settings          Json      @default("{}")
  adminPasswordHash String?
  orderCounter      Int       @default(0)
  orderCounterDate  DateTime?
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Courier {
  id                 String        @id @default(uuid())
  tenantId           String
  unitId             String?
  name               String
  phone              String?
  paymentPerDelivery Decimal?      @db.Decimal(12, 2)
