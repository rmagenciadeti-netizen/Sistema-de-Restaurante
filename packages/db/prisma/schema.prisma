}

model PlanPrice {
  id     String        @id @default(uuid())
  planId String
  period BillingPeriod
  amount Decimal       @db.Decimal(12, 2)
  plan   SaaSPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, period])
}

model TenantLicense {
  id              String         @id @default(uuid())
  tenantId        String         @unique
  status          LicenseStatus  @default(PENDING)
  validUntil      DateTime?
  maxUnits        Int?
  maxUsers        Int?
  notes           String?
  planId          String?
  billingPeriod   BillingPeriod?
  contractedPrice Decimal?       @db.Decimal(12, 2)
  activationFee   Decimal?       @db.Decimal(12, 2)
  setupFee        Decimal?       @db.Decimal(12, 2)
