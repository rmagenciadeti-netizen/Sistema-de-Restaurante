}

model ModifierGroup {
  id        String                 @id @default(uuid())
  tenantId  String
  name      String
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  active    Boolean                @default(true)
  createdAt DateTime               @default(now())
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options   ModifierOption[]
  products  ProductModifierGroup[]

  @@unique([tenantId, name])
}

model ModifierOption {
  id                 String            @id @default(uuid())
  groupId            String
  name               String
  price              Decimal           @default(0) @db.Decimal(12, 2)
  sectorId           String?
  active             Boolean           @default(true)
  group              ModifierGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sector             ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  ingredientId       String?
  ingredientQuantity Decimal?          @db.Decimal(14, 3)
  ingredient         Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([groupId, name])
}

model ProductModifierGroup {
  productId String
  groupId   String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

model OrderItemModifier {
  id                 String    @id @default(uuid())
  orderItemId        String
  optionId           String?
  name               String
  price              Decimal   @db.Decimal(12, 2)
  quantity           Int       @default(1)
  sectorId           String?
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredientId       String?
  ingredientQuantity Decimal?  @db.Decimal(14, 3)

  @@index([orderItemId])
}

model ComboComponent {
  comboId   String
  productId String
  quantity  Int     @default(1)
  combo     Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation("ComboChild", fields: [productId], references: [id], onDelete: Restrict)

  @@id([comboId, productId])
}

model Shift {
  id         String   @id @default(uuid())
  tenantId   String
  unitId     String
  employeeId String
  startsAt   DateTime
  endsAt     DateTime
  position   String?
  notes      String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, unitId, startsAt])
  @@index([employeeId, startsAt])
}

model PaymentCharge {
  id          String        @id @default(uuid())
  tenantId    String
  unitId      String?
  orderId     String
  provider    String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  status      ChargeStatus  @default(PENDING)
  externalRef String?
  qrPayload   String?
  paymentId   String?
  error       String?
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalRef])
  @@index([tenantId, orderId, status])
}

model FiscalDocument {
  id            String            @id @default(uuid())
  tenantId      String
  unitId        String?
  orderId       String
  provider      String
  kind          FiscalKind        @default(NFCE)
  status        FiscalStatus      @default(PENDING)
  series        String?
  number        String?
  accessKey     String?
  documentUrl   String?
  error         String?
  // HOMOLOGATION and PRODUCTION documents never share numbering, XML or protocols.
  environment   FiscalEnvironment @default(PRODUCTION)
  protocol      String?
  statusCode    String?
  // XML exactly as returned by the provider/SEFAZ; exports never rebuild it.
  xml           String?
  // Snapshot of the data sent to the provider (items, taxes, overrides) for audit.
  payload       Json?
  contingency   Boolean           @default(false)
  contingencyAt DateTime?
  attempts      Int               @default(0)
  lastAttemptAt DateTime?
  issuedById    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        FiscalEvent[]

  @@unique([orderId, kind])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, environment, createdAt])
}

// Current series and next sequential number per document kind. Emission reserves the number atomically (see lib/fiscal-numbering.ts).
model FiscalNumbering {
  id          String            @id @default(uuid())
  tenantId    String
  kind        FiscalKind        @default(NFCE)
  series      String            @default("1")
  nextNumber  Int               @default(1)
  environment FiscalEnvironment @default(PRODUCTION)
  // '' = company numbering; a unit id when that establishment issues with its own CNPJ.
  unitKey     String            @default("")
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, unitKey, kind, environment])
}

enum FiscalEnvironment {
  HOMOLOGATION
  PRODUCTION
}

// One fiscal configuration per company (aba Fiscais). Secrets are AES-256-GCM encrypted with FISCAL_ENCRYPTION_KEY.
model FiscalSettings {
  id               String            @id @default(uuid())
  tenantId         String            @unique
  environment      FiscalEnvironment @default(HOMOLOGATION)
  provider         String?
  providerTokenEnc String?
  issuer           Json              @default("{}")
  nfe              Json              @default("{}")
  nfce             Json              @default("{}")
  cscId            String?
  cscTokenEnc      String?
  certPfxEnc       String?
  certPasswordEnc  String?
  certSubject      String?
  certCnpj         String?
  certValidFrom    DateTime?
  certValidTo      DateTime?
  certUploadedAt   DateTime?
  certIssuer       String?
  certSerial       String?
  // A1 today; A3 (token/smart card) needs a local signing agent and is not available yet.
  certType         String            @default("A1")
  // Default CFOPs by operation and destination (saleInternal, saleInterstate, returnInternal, ...).
  cfop             Json              @default("{}")
  // FISCAL: every PDV sale is invoiced; NON_FISCAL: never; ASK: the operator decides at checkout.
  pdvMode          String            @default("NON_FISCAL")
  defaultTaxRuleId String?
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultTaxRule   TaxRule?          @relation(fields: [defaultTaxRuleId], references: [id], onDelete: SetNull)
}

// Establishment-specific fiscal data: its own issuer (CNPJ/IE/address) and A1 certificate. Falls back to the company settings.
model FiscalUnitConfig {
  id              String    @id @default(uuid())
  tenantId        String
  unitId          String    @unique
  issuer          Json      @default("{}")
  certType        String    @default("A1")
  certPfxEnc      String?
  certPasswordEnc String?
  certSubject     String?
  certCnpj        String?
  certIssuer      String?
  certSerial      String?
  certValidFrom   DateTime?
  certValidTo     DateTime?
  certUploadedAt  DateTime?
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Fiscal history: emissions, consultations, cancellations, CC-e, inutilizations and certificate changes, with request/response XML.
model FiscalEvent {
  id            String            @id @default(uuid())
  tenantId      String
  unitId        String?
  documentId    String?
  environment   FiscalEnvironment
  type          String
  status        String
  kind          FiscalKind?
  series        String?
  numberFrom    Int?
  numberTo      Int?
  sequence      Int?
  justification String?
  protocol      String?
  message       String?
  xml           String?
  actorUserId   String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document      FiscalDocument?   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
  @@index([documentId, createdAt])
}

model Integration {
  id         String    @id @default(uuid())
  tenantId   String
  unitId     String?
  provider   String
  name       String
  keyHash    String    @unique
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

