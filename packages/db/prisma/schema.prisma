// One WhatsApp Web (QR) session per tenant. The session manager (worker/API process) owns the socket and credentials on disk;
// the API only writes `desired` and reads status/qr, so both processes coordinate through this row.
model WhatsappSession {
  tenantId    String    @id
  status      String    @default("DISCONNECTED")
  desired     String    @default("DISCONNECTED")
  qr          String?
  phone       String?
  pushName    String?
  lastError   String?
  heartbeatAt DateTime?
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WhatsappConversation {
  id             String                @id @default(uuid())
  tenantId       String
  jid            String
  phone          String?
  name           String?
  customerId     String?
  handoff        Boolean               @default(false)
  handoffUntil   DateTime?
  optOut         Boolean               @default(false)
  unread         Int                   @default(0)
  state          String?
  stateData      Json?
  lastGreetingAt DateTime?
  lastMessageAt  DateTime              @default(now())
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages       WhatsappChatMessage[]

  @@unique([tenantId, jid])
  @@index([tenantId, lastMessageAt])
}

model WhatsappChatMessage {
  id             String               @id @default(uuid())
  tenantId       String
  conversationId String
  direction      String
  source         String
  body           String
  externalId     String?
  createdAt      DateTime             @default(now())
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model WhatsappAutoMessage {
  tenantId String
  key      String
  enabled  Boolean @default(true)
  body     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

model WhatsappKnowledge {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  keywords  String[]
  answer    String
  active    Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// Questions the bot could not answer, aggregated by normalised text so the owner can teach new answers.
model WhatsappUnanswered {
  id          String   @id @default(uuid())
  tenantId    String
  text        String
  count       Int      @default(1)
  lastAskedAt DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, text])
  @@index([tenantId, lastAskedAt])
}

// Liveness of the process that owns WhatsApp sockets (worker or API); the panel uses it to warn when no manager is running.
model WhatsappManager {
  id          String   @id @default("default")
  heartbeatAt DateTime
  pid         Int?
  host        String?
}

// Fiscal registries: they store parameters and documents received by the company; nothing is transmitted to the SEFAZ from here.
model OperationNature {
  id            String            @id @default(uuid())
  tenantId      String
  name          String
  cfop          String
  direction     String            @default("OUT")
  finality      String            @default("NORMAL")
  // Operation rule: operation/destination/UF/regime this CFOP applies to (null = any), optionally with its own tax rule.
  operation     String            @default("SALE")
  destination   String            @default("ANY")
  ufOrigin      String?
  ufDestination String?
  taxRegime     String?
  taxRuleId     String?
  taxRule       TaxRule?          @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  description   String?
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices      ReceivedInvoice[]

  @@unique([tenantId, name])
}

model CstCorrelation {
  id          String   @id @default(uuid())
  tenantId    String
  outCst      String
  inCst       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, outCst])
}

model ReceivedInvoice {
  id               String           @id @default(uuid())
  tenantId         String
  unitId           String?
  accessKey        String
  number           String
  series           String           @default("1")
  supplierName     String
  supplierDocument String?
  issuedAt         DateTime
  totalAmount      Decimal          @db.Decimal(12, 2)
  natureId         String?
  status           String           @default("RECEIVED")
  xml              String?
  items            Json             @default("[]")
  notes            String?
  enteredAt        DateTime?
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  nature           OperationNature? @relation(fields: [natureId], references: [id], onDelete: SetNull)

  @@unique([tenantId, accessKey])
  @@index([tenantId, status, issuedAt])
}

model FiscalContingency {
  id          String    @id @default(uuid())
  tenantId    String
  reason      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  startedById String
  endedById   String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, endedAt])
}

// Product photo kept apart from Product so list queries never load the image bytes.
model ProductImage {
  productId   String   @id
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Card terminals (maquininhas) registered per unit. Only the registry lives here: charging through a terminal still needs the provider's adapter.
model PosDevice {
  id        String   @id @default(uuid())
  tenantId  String
  unitId    String?
  provider  String
  name      String
  serial    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, serial])
  @@index([tenantId, active])
}

// Virtual store profile pictures (logo and cover); bytes are kept apart from the settings JSON.
model StoreImage {
  tenantId    String
  kind        String
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind])
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ModuleBilling {
  MONTHLY
  ANNUAL
  ONE_TIME
  FREE
}

enum CampaignAudience {
  NEW
  EXISTING
  BOTH
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

enum SaaSInvoiceStatus {
  OPEN
  PAID
  CANCELLED
}

// Commercial module catalog. `key` must match a technical feature registered in apps/api/src/lib/licensing.ts to be sellable.
model SaaSModule {
  id            String        @id @default(uuid())
  key           String        @unique
  name          String
  description   String?
  category      String        @default("Geral")
  icon          String?
  status        CatalogStatus @default(ACTIVE)
  blocked       Boolean       @default(false)
  billing       ModuleBilling @default(MONTHLY)
  monthlyPrice  Decimal       @default(0) @db.Decimal(12, 2)
  annualPrice   Decimal       @default(0) @db.Decimal(12, 2)
  oneTimePrice  Decimal       @default(0) @db.Decimal(12, 2)
  promoPrice    Decimal?      @db.Decimal(12, 2)
  promoStartsAt DateTime?
  promoEndsAt   DateTime?
  standalone    Boolean       @default(true)
  dependsOn     String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, category])
}

model SaaSCampaign {
  id             String                 @id @default(uuid())
  name           String
  description    String?
  discountType   DiscountType           @default(PERCENT)
  discountValue  Decimal                @default(0) @db.Decimal(12, 2)
  planIds        String[]               @default([])
  moduleKeys     String[]               @default([])
  startsAt       DateTime
  endsAt         DateTime
  maxUses        Int?
  perTenantLimit Int?
  audience       CampaignAudience       @default(BOTH)
  cycles         Int                    @default(1)
  conditions     String?
  status         CampaignStatus         @default(DRAFT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  redemptions    SaaSCouponRedemption[]
  invoices       SaaSInvoice[]

  @@index([status, startsAt, endsAt])
}

model SaaSCoupon {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  description    String?
  discountType   DiscountType           @default(PERCENT)
  discountValue  Decimal                @default(0) @db.Decimal(12, 2)
  planIds        String[]               @default([])
  moduleKeys     String[]               @default([])
  startsAt       DateTime?
  validUntil     DateTime?
  maxUses        Int?
  perTenantLimit Int?
  audience       CampaignAudience       @default(BOTH)
  cycles         Int                    @default(1)
  minAmount      Decimal?               @db.Decimal(12, 2)
  status         CatalogStatus          @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  redemptions    SaaSCouponRedemption[]
  invoices       SaaSInvoice[]
}

model SaaSCouponRedemption {
  id          String        @id @default(uuid())
  couponId    String?
  campaignId  String?
  tenantId    String
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  actorUserId String?
  createdAt   DateTime      @default(now())
  coupon      SaaSCoupon?   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  campaign    SaaSCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     SaaSInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([couponId, tenantId])
  @@index([campaignId, tenantId])
  @@index([invoiceId])
}

// Subscription charge. Payment is only ever marked by an administrator (manual reconciliation) or a validated provider webhook.
model SaaSInvoice {
  id               String                 @id @default(uuid())
  seq              Int                    @unique @default(autoincrement())
  tenantId         String
  planId           String?
  reference        String
  status           SaaSInvoiceStatus      @default(OPEN)
  period           BillingPeriod?
  items            Json                   @default("[]")
  subtotal         Decimal                @db.Decimal(12, 2)
  discount         Decimal                @default(0) @db.Decimal(12, 2)
  total            Decimal                @db.Decimal(12, 2)
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  couponId         String?
  campaignId       String?
  notes            String?
  createdBy        String?
  paidBy           String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             SaaSPlan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  coupon           SaaSCoupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  campaign         SaaSCampaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  redemptions      SaaSCouponRedemption[]

  @@index([tenantId, status, dueDate])
  @@index([status, dueDate])
  @@index([paidAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  WON
  LOST
}

// Support requests opened by a restaurant and handled in RM Painel Admin. Internal messages are never shown to the restaurant.
model SupportTicket {
  id             String           @id @default(uuid())
  seq            Int              @unique @default(autoincrement())
  tenantId       String
  openedByUserId String?
  subject        String
  category       String           @default("Geral")
  priority       TicketPriority   @default(NORMAL)
  status         TicketStatus     @default(OPEN)
  adminNotes     String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages       SupportMessage[]

  @@index([tenantId, status, updatedAt])
  @@index([status, priority, updatedAt])
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  authorUserId String?
  fromAdmin    Boolean       @default(false)
  internal     Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Interested restaurants captured by the public demo/onboarding form.
model SaaSLead {
  id        String     @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String
  city      String?
  interest  String?
  message   String?
  kind      String     @default("DEMO")
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

// RM Smart Migration: one session per import of an external system into a single restaurant (tenant).
model MigrationSession {
  id                  String            @id @default(uuid())
  tenantId            String
  // Destination unit of the unit-bound records (sales, payments, payables/receivables, opening stock, employees). Null = company-wide, as before.
  unitId              String?
  createdById         String?
  label               String
  sourceSystem        String?
  sourceUnknown       Boolean           @default(false)
  // DRAFT, ANALYZED, PREVIEWED, APPROVED, RUNNING, COMPLETED, FAILED, CANCELLED, ROLLED_BACK
  status              String            @default("DRAFT")
  // VALIDATED, WITH_CAVEATS, PARTIAL, INTERRUPTED, FAILED_VALIDATION
  outcome             String?
  engineVersion       String
  analysis            Json?
  mapping             Json?
  summary             Json?
  validation          Json?
  approvedById        String?
  approvedAt          DateTime?
  startedAt           DateTime?
  finishedAt          DateTime?
  rolledBackAt        DateTime?
  cancelRequested     Boolean           @default(false)
  backupConfirmedAt   DateTime?
  backupReference     String?
  backupConfirmedById String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  files               MigrationFile[]
  records             MigrationRecord[]
  events              MigrationEvent[]
  backups             MigrationBackup[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model MigrationFile {
  id        String           @id @default(uuid())
  sessionId String
  tenantId  String
  name      String
  size      Int
  sha256    String
  format    String
  content   Bytes?
  purgedAt  DateTime?
  createdAt DateTime         @default(now())
  session   MigrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sha256])
  @@index([tenantId, sessionId])
}

// RM Smart Migration: tenant-scoped pre-migration backup of every table the engine writes. The file lives outside the database (encrypted when a key
// is configured); VERIFIED means the file was re-read, its hashes matched and a real restore into an isolated target compared equal to the original.
// Status: CREATING, VERIFIED, FAILED, INVALID (a previously verified file that no longer passes the integrity check).
model MigrationBackup {
  id            String           @id @default(uuid())
  tenantId      String
  sessionId     String
  createdById   String?
  status        String           @default("CREATING")
  stage         String?
  fileKey       String?
  fileSize      Int?
  sha256        String?
  encrypted     Boolean          @default(false)
  database      Json
  manifest      Json?
  verification  Json?
  error         String?
  engineVersion String
  createdAt     DateTime         @default(now())
  verifiedAt    DateTime?
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session       MigrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId, createdAt])
}

// One staged source row. Status: VALID, DIVERGENT, DUPLICATE, REJECTED, IGNORED, IMPORTED, FAILED.
model MigrationRecord {
  id            String           @id @default(uuid())
  sessionId     String
  tenantId      String
  entity        String
  tableName     String
  rowIndex      Int
  seq           Int              @default(0)
  sourceKey     String?
  status        String
  original      Json
  normalized    Json?
  corrections   Json?
  issues        Json?
  approved      Boolean          @default(false)
  targetId      String?
  targetCreated Boolean          @default(false)
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  session       MigrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, tableName, rowIndex])
  @@index([sessionId, entity, status])
  @@index([tenantId, targetId])
}

model MigrationEvent {
  id          String           @id @default(uuid())
  sessionId   String
  tenantId    String
  actorUserId String?
  type        String
  message     String
  data        Json?
  createdAt   DateTime         @default(now())
  session     MigrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Approved column mappings, keyed by the structure of the source (never by restaurant data), so similar exports are pre-mapped next time.
model MigrationMappingTemplate {
  id          String   @id @default(uuid())
  signature   String
  entity      String
  columns     Json
  timesUsed   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([signature, entity])
}

// Financial structure. FinancialEntry.costCenterId / bankAccountId point here; there is no parallel ledger.
model CostCenter {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  code             String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialEntries FinancialEntry[]

  @@unique([tenantId, name])
}

model BankAccount {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  bank             String?
  agency           String?
  accountNumber    String?
  initialBalance   Decimal          @default(0) @db.Decimal(14, 2)
  initialBalanceAt DateTime?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialEntries FinancialEntry[]

  @@unique([tenantId, name])
}

// Cost and price-formation inputs per product. A null percentage/amount inherits the company default (Settings: products, profit and pricing sections).
model ProductPricing {
  id                     String   @id @default(uuid())
  tenantId               String
  productId              String   @unique
  freightCost            Decimal  @default(0) @db.Decimal(12, 2)
  otherAcquisitionCost   Decimal  @default(0) @db.Decimal(12, 2)
  marginPercent          Decimal? @db.Decimal(7, 2)
  operationalCostPercent Decimal? @db.Decimal(6, 3)
  operationalCostFixed   Decimal? @db.Decimal(12, 2)
  taxPercent             Decimal? @db.Decimal(6, 3)
  cardFeePercent         Decimal? @db.Decimal(6, 3)
  commissionPercent      Decimal? @db.Decimal(6, 3)
  otherVariablePercent   Decimal? @db.Decimal(6, 3)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Append-only history of price/cost changes made through the pricing module.
model PriceHistory {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  reason      String
  actorUserId String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
}

enum TefStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  TIMEOUT
  UNKNOWN
  ERROR
  REVERSED
}

enum TefIntegrationStatus {
  NOT_CONFIGURED
  AWAITING_CREDENTIALS
  CONFIGURED
  IN_TESTING
  HOMOLOGATED
  PRODUCTION_ENABLED
  FAILED
}

// Per-company configuration of one TEF provider. Secrets are sealed (AES-256-GCM, FISCAL_ENCRYPTION_KEY) and never returned by the API.
model TefProviderConfig {
  id                   String               @id @default(uuid())
  tenantId             String
  provider             String
  environment          String               @default("HOMOLOGATION")
  integrationStatus    TefIntegrationStatus @default(NOT_CONFIGURED)
  establishmentCnpj    String?
  merchantCode         String?
  logicalNumber        String?
  terminalId           String?
  cashRegisterId       String?
  pinpad               String?
  connection           Json?
  credentialsEnc       String?
  printing             Json?
  enabledMethods       String[]
  acceptedBrands       String[]
  financialMapping     Json?
  homologationEvidence String?
  lastTestAt           DateTime?
  lastTestOk           Boolean?
  lastTestMessage      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

// One payment attempt at a TEF provider. The Payment (and so the financial/cash/fiscal data) only exists after a validated approval.
model TefTransaction {
  id                String        @id @default(uuid())
  tenantId          String
  unitId            String?
  orderId           String
  cashSessionId     String?
  provider          String
  simulated         Boolean       @default(false)
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  installments      Int           @default(1)
  status            TefStatus     @default(PENDING)
  idempotencyKey    String
  providerRef       String?
  nsu               String?
  authorizationCode String?
  cardBrand         String?
  acquirerCnpj      String?
  pixEndToEnd       String?
  terminalId        String?
  responseCode      String?
  responseMessage   String?
  paymentId         String?       @unique
  operatorUserId    String?
  reversalRef       String?
  reversalReason    String?
  reversedByUserId  String?
  reversedAt        DateTime?
  requestedAt       DateTime      @default(now())
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment           Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  events            TefEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, orderId])
}

model TefEvent {
  id            String         @id @default(uuid())
  tenantId      String
  transactionId String
  fromStatus    TefStatus?
  toStatus      TefStatus
  note          String?
  payload       Json?
  actorUserId   String?
  createdAt     DateTime       @default(now())
  transaction   TefTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
}

// Every AI-related operation of a company (deterministic analysis, model call, cache hit, denial...). Limits and the consumption panel read this table, so they survive deploys and are shared by all instances.
model AiUsageEvent {
  id              String   @id @default(uuid())
  tenantId        String
  unitId          String?
  userId          String?
  module          String
  operation       String
  kind            String
  provider        String?
  model           String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  tokensEstimated Boolean  @default(false)
  latencyMs       Int      @default(0)
  ok              Boolean  @default(true)
  errorCode       String?
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([tenantId, userId, createdAt])
}

model AiConversation {
  id        String      @id @default(uuid())
  tenantId  String
  unitId    String?
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([tenantId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  tenantId       String
  role           String
  content        String
  domains        String[]
  meta           Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}
