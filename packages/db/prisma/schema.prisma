}

model FinancialCategory {
  id        String              @id @default(uuid())
  tenantId  String
  parentId  String?
  parent    FinancialCategory?  @relation("FinancialCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  FinancialCategory[] @relation("FinancialCategoryTree")
  type      FinancialEntryType
  name      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, name])
}

model Promotion {
  id        String             @id @default(uuid())
  tenantId  String
  name      String
  type      DiscountType
  value     Decimal            @db.Decimal(12, 2)
  startsAt  DateTime
  endsAt    DateTime?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
