generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(TRIAL)
  plan        PlanType     @default(BASIC)
  country     String       @default("BR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  units       Unit[]
  users       User[]
  employees   Employee[]
  categories  ProductCategory[]
  sectors     ProductionSector[]
  printers    Printer[]
  products    Product[]
  orders      Order[]
  auditLogs   AuditLog[]
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  employees Employee[]
  sectors   ProductionSector[]
  printers  Printer[]
  products  Product[]
  orders    Order[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  unitId       String?
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  @@index([tenantId, unitId, status])
}

model Employee {
  id            String   @id @default(uuid())
  tenantId      String
  unitId        String?
  fullName      String
  cpf           String?
  phone         String?
  email         String?
  position      String?
  status        String   @default("ACTIVE")
  admissionDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, status])
  @@index([tenantId, fullName])
}

model ProductCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  @@unique([tenantId, name])
}

model ProductionSector {
  id        String    @id @default(uuid())
  tenantId  String
  unitId    String?
  name      String
  code      String?
  color     String?
  autoPrint Boolean   @default(false)
  showOnKds Boolean   @default(true)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  printers  Printer[]
  products  Product[]
  orderItems OrderItem[]
  @@unique([tenantId, unitId, name])
  @@index([tenantId, unitId, active])
}

model Printer {
  id        String   @id @default(uuid())
  tenantId  String
  unitId    String?
  sectorId  String?
  name      String
  connectionType String
  address   String?
  port      Int?
  paperWidthMm Int   @default(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sector    ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  @@index([tenantId, unitId, active])
}

model Product {
  id               String           @id @default(uuid())
  tenantId         String
  unitId           String?
  categoryId       String?
  sectorId         String?
  name             String
  code             String?
  description      String?
  price            Decimal          @db.Decimal(12, 2)
  cost             Decimal?         @db.Decimal(12, 2)
  stockMin         Decimal?         @db.Decimal(12, 3)
  prepTimeMinutes  Int?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sector           ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  @@unique([tenantId, code])
  @@index([tenantId, unitId, active])
  @@index([tenantId, name])
}

model Order {
  id           String       @id @default(uuid())
  tenantId     String
  unitId       String?
  code         String
  channel      OrderChannel @default(POS)
  status       OrderStatus  @default(OPEN)
  customerName String?
  tableLabel   String?
  subtotal     Decimal      @db.Decimal(12, 2)
  serviceFee   Decimal      @default(0) @db.Decimal(12, 2)
  deliveryFee  Decimal      @default(0) @db.Decimal(12, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  @@unique([tenantId, code])
  @@index([tenantId, unitId, status, createdAt])
}

model OrderItem {
  id        String           @id @default(uuid())
  orderId   String
  productId String
  sectorId  String?
  quantity  Int
  unitPrice Decimal          @db.Decimal(12, 2)
  total     Decimal          @db.Decimal(12, 2)
  notes     String?
  status    OrderItemStatus  @default(PENDING)
  createdAt DateTime         @default(now())
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector    ProductionSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  @@index([orderId, status])
  @@index([sectorId, status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

enum TenantStatus { ACTIVE TRIAL SUSPENDED BLOCKED }
enum PlanType { BASIC PRO PREMIUM ENTERPRISE }
enum UserRole { MASTER_ADMIN ADMIN MANAGER CASHIER WAITER KITCHEN DELIVERY FINANCE SUPPORT }
enum UserStatus { ACTIVE INACTIVE BLOCKED }
enum OrderChannel { POS DELIVERY TAKEAWAY WHATSAPP TABLE }
enum OrderStatus { OPEN PREPARING READY COMPLETED CANCELLED }
enum OrderItemStatus { PENDING PREPARING READY CANCELLED }
