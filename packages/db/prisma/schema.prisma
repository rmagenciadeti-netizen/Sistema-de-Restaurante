// Audit trail of operations authorised with the administrator password (cancel, discount, cash withdrawal, ...).
model PasswordRelease {
  id                String   @id @default(uuid())
  tenantId          String
  unitId            String?
  action            String
  orderId           String?
  requestedByUserId String
  reason            String?
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// Tax parameters per product group. Stored for the fiscal provider; the API does not compute or transmit taxes by itself.
model TaxRule {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  ncm              String?
  cest             String?
  origin           Int               @default(0)
  cfop             String?
  icmsCst          String?
  icmsRate         Decimal?          @db.Decimal(6, 3)
  icmsReduction    Decimal?          @db.Decimal(6, 3)
  pisCst           String?
  pisRate          Decimal?          @db.Decimal(6, 3)
  cofinsCst        String?
  cofinsRate       Decimal?          @db.Decimal(6, 3)
  // CFOP for interstate sales (cfop is used inside the state).
  cfopInterstate   String?
  icmsStMva        Decimal?          @db.Decimal(6, 3)
  icmsStRate       Decimal?          @db.Decimal(6, 3)
  icmsStReduction  Decimal?          @db.Decimal(6, 3)
  fcpRate          Decimal?          @db.Decimal(6, 3)
  fcpStRate        Decimal?          @db.Decimal(6, 3)
  cBenef           String?
  ipiCst           String?
  ipiEnquadramento String?
  ipiRate          Decimal?          @db.Decimal(6, 3)
  ibsCbsCst        String?
  cClassTrib       String?
  ibsUfRate        Decimal?          @db.Decimal(6, 3)
  ibsMunRate       Decimal?          @db.Decimal(6, 3)
  cbsRate          Decimal?          @db.Decimal(6, 3)
  isRate           Decimal?          @db.Decimal(6, 3)
  validFrom        DateTime?
  validTo          DateTime?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
