DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rm_restaurant?schema=public"
PORT=4000
API_INTERNAL_URL="http://127.0.0.1:4000/api/v1"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
MFA_ENCRYPTION_KEY=""
# 32 bytes (openssl rand -base64 32): encrypts A1 certificates, CSC and fiscal provider tokens. Keep a safe copy.
FISCAL_ENCRYPTION_KEY=""
# TEF: tempo máximo (ms) de espera do provedor (padrão 90000). O simulador só funciona fora de produção e nunca é um provedor real.
TEF_TIMEOUT_MS=90000
TEF_ENABLE_SIMULATOR=false
# Somente desenvolvimento: dispensa o MFA do Master. Ignorado com NODE_ENV=production.
DEV_DISABLE_MFA=false
# Origens exatas permitidas (produção). Fora de produção a API aceita qualquer origem (Codespaces/proxy).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
MASTER_ADMIN_EMAIL="admin@example.com"
MASTER_ADMIN_USERNAME="admin"
MASTER_ADMIN_PASSWORD="replace-with-a-unique-password-12-chars-minimum"
RM_RESTAURANT_URL="http://localhost:3000"
RM_ADMIN_URL="http://localhost:3001"

# Optional SMTP delivery for one-time password recovery links.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Opcional: worker de WhatsApp (API oficial). Sem estas variáveis a fila permanece QUEUED.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATES={"order_ready":{"name":"pedido_pronto","language":"pt_BR","params":["customerName","orderCode"]}}

# WhatsApp por QR Code (WhatsApp Web, não oficial). Padrão 'auto': a API e o worker podem rodar juntos; só um opera as sessões (eleição por banco).
# 'api' / 'worker' restringem onde roda; 'off' desativa. As credenciais do pareamento ficam CRIPTOGRAFADAS no banco (sobrevivem a deploys),
# usando WHATSAPP_AUTH_ENCRYPTION_KEY (ou MFA_ENCRYPTION_KEY). O cliente só lê o QR Code; nada para configurar.
# WHATSAPP_SESSIONS_MODE=auto
# WHATSAPP_AUTH_ENCRYPTION_KEY=""
# WHATSAPP_MAX_SESSIONS=25
# Só para desenvolvimento: WHATSAPP_AUTH_STORE=file guarda as credenciais em disco (WHATSAPP_SESSION_DIR).

# Provedor de IA (OpenAI, Anthropic, Gemini, Groq, OpenRouter ou endpoint compatível). Pode ser definido aqui OU no RM Painel Admin ›
# Serviços da plataforma (a chave fica criptografada no banco e prevalece sobre estas variáveis). A pergunta do cliente e dados públicos do cardápio vão ao provedor.
# AI_PROVIDER="openai"   # openai | anthropic | gemini | groq | openrouter | custom
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_CONFIG_ENCRYPTION_KEY=""  # opcional; padrão MFA_ENCRYPTION_KEY

# RM Smart Migration: em produção (NODE_ENV=production) a autorização da execução exige um backup gerado e restaurado/validado pela plataforma
# (tenant + migração). 'true' força a exigência em qualquer ambiente; 'false' a desliga em produção.
# MIGRATION_REQUIRE_BACKUP=""
# Pasta (fora do banco, com permissão restrita) onde os arquivos de backup ficam. Obrigatória em produção.
# MIGRATION_BACKUP_DIR=""
# Chave AES-256 (32 bytes, hex ou base64) que criptografa os arquivos de backup. Obrigatória quando o backup é exigido ou em produção.
# MIGRATION_BACKUP_ENCRYPTION_KEY=""
# Banco PostgreSQL isolado (já migrado, NUNCA o de produção) usado para testar a restauração. Sem ele, usa-se um esquema temporário no banco principal.
# MIGRATION_BACKUP_VERIFY_DATABASE_URL=""
# Idade máxima (minutos) do backup validado no momento da autorização. Padrão: 60.
# MIGRATION_BACKUP_MAX_AGE_MINUTES=""

# ---- Produção (Render/Vercel/Neon) ----
# Com NODE_ENV=production a API recusa iniciar (fail-fast) se faltar/estiver inválido: JWT_SECRET (>=32, sem valor de exemplo), MFA_ENCRYPTION_KEY (32 bytes),
# DATABASE_URL (Neon exige ?sslmode=require), CORS_ORIGIN (origens exatas, sem "*"), RM_RESTAURANT_URL, RM_ADMIN_URL e FISCAL_ENCRYPTION_KEY/MIGRATION_BACKUP_ENCRYPTION_KEY quando informadas.
# NODE_ENV=production
# Render (runtime): DATABASE_URL com o pooler do Neon. Prisma Migrate (CI/deploy de migrations): use a conexão DIRETA do Neon (sem -pooler).
# Vercel (projetos Web e Admin): API_INTERNAL_URL é obrigatória; Preview deve apontar para uma API de staging. NEXT_PUBLIC_RM_APP=admin apenas no projeto Admin.
# Limite diário de análises com IA generativa por estabelecimento (RM Inteligência). Padrão: 10.
# AI_DAILY_LIMIT=10
# Chave que assina as respostas idempotentes de provisionamento; sem ela usa-se JWT_SECRET.
# IDEMPOTENCY_SECRET=""
# Desliga o adaptador Focus NFe (ex.: ambientes sem credencial fiscal).
# FISCAL_FOCUSNFE_DISABLED=false
# Intervalo do worker (ms). Padrão: 10000.
# WORKER_INTERVAL_MS=10000
# Resumo do worker no log (ms). Padrão: 300000. Prova de funcionamento: GET /api/v1/health/worker (docs/DEPLOY.md).
# WORKER_LOG_EVERY_MS=300000
# Somente seeds de desenvolvimento/instalação:
# MASTER_ADMIN_NAME=""
# DEV_OPERATOR_EMAIL=""
# DEV_OPERATOR_PASSWORD=""
# Agente de impressão (computador do restaurante): RM_API_URL e RM_AGENT_TOKEN (o token é exibido uma única vez; nunca versione).
# Intervalo de consulta da fila do agente de impressão (ms). Padrão: 3000.
# RM_POLL_INTERVAL_MS=3000
# Opcional (testes fiscais): pasta com os XSDs oficiais PL_010 para validar o XML da NF-e (requer xmllint).
# NFE_XSD_DIR=""

# SUPER IA: modelo econômico opcional para perguntas simples (classificação e um único especialista). Sem ele usa AI_MODEL.
# AI_MODEL_SIMPLE=""
