DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rm_restaurant?schema=public"
PORT=4000
API_INTERNAL_URL="http://127.0.0.1:4000/api/v1"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
MFA_ENCRYPTION_KEY=""
# 32 bytes (openssl rand -base64 32): encrypts A1 certificates, CSC and fiscal provider tokens. Keep a safe copy.
FISCAL_ENCRYPTION_KEY=""
# Somente desenvolvimento: dispensa o MFA do Master. Ignorado com NODE_ENV=production.
DEV_DISABLE_MFA=false
# Origens exatas permitidas (produção). Fora de produção a API aceita qualquer origem (Codespaces/proxy).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
MASTER_ADMIN_EMAIL="admin@example.com"
MASTER_ADMIN_USERNAME="admin"
MASTER_ADMIN_PASSWORD="replace-with-a-unique-password-12-chars-minimum"
RM_RESTAURANT_URL="http://localhost:3000"
RM_ADMIN_URL="http://localhost:3001"

# Optional SMTP delivery for one-time password recovery links.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Opcional: worker de WhatsApp (API oficial). Sem estas variáveis a fila permanece QUEUED.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATES={"order_ready":{"name":"pedido_pronto","language":"pt_BR","params":["customerName","orderCode"]}}

# WhatsApp por QR Code (WhatsApp Web, não oficial). 'api' roda as sessões dentro da API (padrão fora de produção),
# 'worker' deixa para `npm run worker --workspace apps/api` (padrão em produção), 'off' desativa. Rode apenas UM gerenciador.
# WHATSAPP_SESSIONS_MODE=api
# A pasta guarda as credenciais da sessão (trate como senha; use volume persistente).
# WHATSAPP_SESSION_DIR=.whatsapp-sessions

# IA opcional para o robô (endpoint compatível com OpenAI chat/completions). A pergunta do cliente e dados públicos do cardápio são enviados ao provedor.
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL="https://api.openai.com/v1"
